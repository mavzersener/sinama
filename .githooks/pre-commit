#!/bin/sh
# sinama pre-commit — ADR-001 md.5: özel veri ve sır depoya GİREMEZ.
#   1) Veri bekçisi index'teki içeriği denetler (çalışma ağacını değil).
#   2) Kök birim testleri (bekçi).
#   3) cekirdek/ değiştiyse çekirdek birim testleri (~15 sn). Tam kapı
#      (kapsam + MCP + demolar: cekirdek/test.sh) CI'da koşar.
# --no-verify ile atlanırsa bekçi push'ta yine çalışır (pre-push).
set -e
cd "$(git rev-parse --show-toplevel)"
export PYTHONUTF8=1 PYTHONDONTWRITEBYTECODE=1
. ./.githooks/_python.sh
"$PY" betikler/veri_bekcisi.py --staged
"$PY" -m unittest discover -s tests -q
if git diff --cached --name-only | grep -q '^cekirdek/'; then
  echo "[kapı] çekirdek birim testleri"
  (cd cekirdek && "$PY" -m unittest discover -s tests -q)
fi
